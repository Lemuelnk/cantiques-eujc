          },
          "content": [
            {
              "type": "source_block",
              "lines": [
                "Ulikuwa (wewe) 2x katika edeni shamba la Mungu kerubi lenye kungaa, Lucifero ulipendwa na Bwana Mumba wako kakuvika mawe ya bei lulu ya damani."
              ]
            },
            {
              "type": "refrain",
              "lines": [
                "Lusifero kwa wingi wa uchuruzi ulitengwa mbali na Mungu wa uzima.",
                "- ulipo jitukuza",
                "- ulipo jinyanyuwa karibieni mumbaji toka mu mambo ya watu 2x"
              ]
            },
            {
              "type": "source_block",
              "lines": [
                "Uliponena moyoni mwako Lusifero nitapaa juu mbinguni kuliko nyota za Bwana, kuliko mulima wake takuwa juu."
              ]
            },
            {
              "type": "source_block",
              "lines": [
                "Apo, apo, vita mbinguni Mikaeli na yule joka, shetani katupua chini na jeshi lake lote, Diabolo katupua chini na jeshi lake lote mukia ukakokota sehemu moja ku tatu ya nyota za mbingu furahini mbingu ole wako dunia."
              ]
            }
          ],
          "media": {
            "audio_present": false
          }
        }
      ]
    },
