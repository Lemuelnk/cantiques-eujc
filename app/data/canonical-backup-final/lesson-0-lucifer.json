              ]
            },
            {
              "type": "refrain",
              "lines": [
                "(Wajoli twimbe na faraha) na furaha tutaiona (tutaiona)mioyoi ikitakaswa sana (kwake)kwake mwokozi kuonana(kuonana) na milele kukaa."
              ]
            },
            {
              "type": "source_block",
              "lines": [
                "Wana na wazee watwambia furahaini mukisikia (wajoli) ndie Mufalme wetu pia natumusii njo."
              ]
            },
            {
              "type": "source_block",
              "lines": [
                "Tumukaribie eh sisi zote Yesu Bwana utualika tumupingapo nimuoti na tumusii njo"
              ]
