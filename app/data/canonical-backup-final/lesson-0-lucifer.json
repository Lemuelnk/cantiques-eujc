          },
          "content": [
            {
              "type": "source_block",
              "lines": [
                "Ewe malaika wa nuru, ewe nyota alfajiri lusifero ulipendwa sana kuko Bwana Mumba wako Akakuvika mawe ya bei lulu ya damani kubwa 2x"
              ]
            },
            {
              "type": "refrain",
              "lines": [
                "Uchuruzi wako ulikujaza uzalimu toka katikati ya mawe ya moto wewe ulitenda zambi, lucifero ulinena kwamba nitapaa juu mbinguni kuliko mulima wa Mungu, lucifero ulinena kwamba nitapaa juu mbinguni kuliko nyota za Bwana."
              ]
            },
            {
              "type": "source_block",
              "lines": [
                "Mawe ya bei lusifero uliyo vikua tazama, yakiki nyekundu, yakuti ya manjano, ulivikua na alimasi, zabarajadi, zumaridi na ya aspi, baharamani, shoamu na zahabu."
              ]
            },
            {
              "type": "source_block",
              "lines": [
                "Vita kutoka mbinguni Mikaeli na jeshi lake kupigana na yule shetani na kundi lake lote Diabolo akatupwa chini na kundi lake lote, furahini ninyi mbingu pia na malaika wote ole wenu duniani na waishio ndani ya bahari, furahini ninyi watu waishimo mu neno la mungu."
              ]
            }
          ],
          "media": {
            "audio_present": true
          }
        }
      ]
