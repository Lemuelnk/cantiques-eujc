              "type": "verse",
              "number": "1",
              "lines": [
                "Mufulume wangu zawabu ni kubwa , sita weza kuliimiliki (ah ah) neno la haki huku wajali wenye hekima ukawapa watoto wa changa."
              ]
            },
            {
              "id": "blk-1f30f444",
              "type": "refrain",
              "lines": [
                "(Neno lako) neno lako la wokovu mupenzi la dumu ata leo ni mbele yake hawai yeyote atakae amini \" Yupi atakae nena mimi sikulisikia neno , neno hili neno la wokovu\"2x"
              ]
            },
            {
              "id": "blk-707083c4",
              "type": "verse",
              "number": "2",
              "lines": [
                "Zamani za nuhu watu walifanya anasa hawa kumutegemea mungu nayo mvua ikanyesha watu wakamutafuta bwana na kazalika hakuwasikia."
              ]
            },
            {
              "id": "blk-7192fc3a",
              "type": "verse",
              "number": "3",
              "lines": [
                "Zamani za lutu watu walifanya ginsi vitendekavio ata leo wanadamu walipinga kusikia maagizo ya bwana akawateketeza kwa moto."
              ]
            }
          ]
        }
