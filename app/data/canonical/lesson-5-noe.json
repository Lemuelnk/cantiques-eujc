              "id": "blk-3d915e1b",
              "type": "verse",
              "number": "1",
              "lines": [
                "Tumekwisha dumu sisi katika giza \" Leo nuru imeangaa mioyoni mwa watu \"2x Jehova mungu akatuma mutu mwema noa dunia imearibika ni taharibu inchi e we noa jenga safina tangamiza watu."
              ]
            },
            {
              "id": "blk-4a60bec4",
              "type": "refrain",
              "lines": [
                "Kwa leo ni fanye chombo ni hubiri neno kwa lugha zote kwa kila nyumba kwa kila mutu duniani pote."
              ]
            },
            {
              "id": "blk-8374c732",
              "type": "verse",
              "number": "2",
              "lines": [
                "Alipo kuwa Musa katika misri , mungu akatuma Musa kwa Farao kachukuwe israeli ende noa mujangwani kachukuwe watu wangu ende noa mujangwani."
              ]
            },
            {
              "id": "blk-9b48db49",
              "type": "verse",
              "number": "3",
              "lines": [
                "Alipo shindwa musa katika jangwa , Yoshua ,wana wa nuni kainuliwa kachukuwe watu wanguende noa mu kanana kachukue israeli ende noa mukanana."
              ]
            }
          ]
        }
