              ]
            },
            {
              "id": "blk-40f38d8d",
              "type": "source_block",
              "lines": [
                "Bwana kaondoa mulango viumbe viote vikatoka safina vikaenda zao Noa katika inchini akawa eh noa mulimaji mizabibu.",
                "- Noa kakunywa muvinyo",
                "- Noa kabaki utupu",
                "- Noa akafunuliwa",
