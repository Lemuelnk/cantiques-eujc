            {
              "id": "blk-834d4e76",
              "type": "refrain",
              "lines": [
                "Basi tazama nuhu utupu eh nuhu hemani mwake",
                "- Kwa mizabibu yake: utupu eh nuhu hemani mwake",
                "- Huko ndani ya hema: utupu eh nuhu hemani mwake",
                "- Kafunuliwa: utupu eh nuhu hemani mwake"
              ]
            },
            {
              "id": "blk-c3b3a3ee",
              "type": "source_block",
              "lines": [
                "Hamu naye kaingia hemani, hamu naye kakuta babae utupu eh nuhu hemani mwake. Hamu naye kambia nduguze, Ndugu zake wakaja na nguo kumufinika nuhu"
              ]
            },
            {
              "id": "blk-871d45d4",
              "type": "source_block",
              "lines": [
                "Nuhu naye alipo amuka, nuhu naye kalaani kanana mwana wa hamu (Alaaniwe kanana, kanana, kanana umelaaniwa) 2x",
                "- Muchongezi wa watu: kanana, kanana umelaaniwa",
                "- Musaliti wa neno: kanana, kanana umelaaniwa",
                "- Mwaminifu muongo: kanana, kanana umelaaniwa"
              ]
            }
