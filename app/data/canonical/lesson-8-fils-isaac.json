            {
              "id": "blk-e1b8441e",
              "type": "source_block",
              "lines": [
                "Rebeka katayarisha wana mbuzi wa wili akampa Yakobo ampelekee Isaka amuongezee baraka."
              ]
            },
            {
              "id": "blk-c87c4494",
              "type": "source_block",
              "lines": [
                "Esau kauzunika (kachukizwa ) kalia"
