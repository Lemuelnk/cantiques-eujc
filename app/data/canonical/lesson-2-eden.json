            {
              "type": "source_block",
              "lines": [
                "Muto kutoka Edeni, kunyesha shambani (Bwana mungu akapanda shamba kwa upande wa mashariki ya Edeni)2x"
              ]
            },
            {
              "type": "refrain",
              "lines": [
                "Shamba la Edeni shamba lake Mungu 2x Eh shamba langu mimi baba, eh baba limekuwa pango la shetani.",
                "- Limepandwa na miba",
                "- Limejazwa magugu",
                "- Limelimwa na watu"
              ]
            },
            {
              "type": "source_block",
              "lines": [
                "2. Bwana akapanda shambani, muti wa uzima kwa lakini shetani naye kapanda mut iwa mauti kweli, kweli shamba langu eh baba shamba langu limearibika."
              ]
            },
            {
              "type": "source_block",
              "lines": [
                "3.\tMupandaji mbegu akapanda ya gano kwa lakini shetani naye jioni kapanda magugu, kweli, kweli shamba langu eh baba shamba langu limearibika.",
                "- Ulipanda ulozi",
                "- Ulipanda fitina",
                "- Ulipanda bongo"
              ]
            }
          ],
          "media": {
            "audio_present": false
          }
        }
      ]
