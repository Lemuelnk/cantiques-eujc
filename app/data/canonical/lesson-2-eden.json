            "category_label": "Éden",
            "lesson_id": "lesson-2",
            "lesson_label": "Leçon 2 — Éden"
          },
          "content": [
            {
              "type": "source_block",
              "lines": [
                "Jina lako nani hili nili nilitukuze (jina langu mimi neno lako la uzima)2x"
              ]
            },
            {
              "type": "refrain",
              "lines": [
                "Eh jina langu mimi, baba eh baba neno lako la uzima",
                "- Mungu wangu usinite muchawi baba eh baba neno lako la uzima",
                "- Mungu wangu usinite mulozi baba eh baba neno lako la uzima"
              ]
            },
            {
              "type": "source_block",
              "lines": [
                "Shamba langu mimi ni mepanda mimea, miti yote ya Edeni ilikuwa ndani yake kweli, Muti muzuri kwa chakula pia na wakutazama, na mut iwa mauti pia na wa uzima"
              ]
            },
            {
              "type": "source_block",
              "lines": [
                "Ukumu imekwisha fika tujiweke tayari (Kazi yake kweli mungu imetimia leo)2x Akutakuwa unyumba mbele yake jehova mungu Akutakuwa kabila mbele yake jehova mungu Ila neno lake kweli ndilo litakalo timilika"
              ]
            }
          ],
          "media": {
            "audio_present": false
          }
        }
      ]
    },
