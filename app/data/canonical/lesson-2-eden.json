          },
          "content": [
            {
              "type": "source_block",
              "lines": [
                "Twakushukuru eh mungu wangu katika, kazi uliotenda tangu hawali zimetimilika leo (kazi gani) kuokowa dunia katika mikono ya shetani, (kazi gani) kuokoa dunia katika shida na magonjwa (kazi gani)kuokoa dunia katika kiburi na jeuri."
              ]
            },
            {
              "type": "refrain",
              "lines": [
                "Neno, neno lake eh baba limeshuka duniani yoyoyo neno ili neno lake la uzima.",
                "Na mitume walishuka na neno",
                "Na Kadima alishuka na neno"
              ]
            },
            {
              "type": "source_block",
              "lines": [
                "Kutoka pisoni, gioni kaona, idekeli kaona, furati ndie uzima¨Yoyoyo"
              ]
            }
          ],
          "media": {
            "audio_present": false
          }
        }
      ]
