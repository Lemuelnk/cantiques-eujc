          },
          "title": "KUKALE MU EDENA",
          "source": {
            "file": "chants_deden.html",
            "position": 4,
            "number": "40",
            "reference": "awalimuedenitshiluba.mpeg"
          },
          "taxonomy": {
            "domain": "lessons",
            "category_id": "lesson-2",
            "category_label": "Éden",
            "lesson_id": "lesson-2",
            "lesson_label": "Leçon 2 — Éden"
          },
          "content": [
            {
              "type": "source_block",
              "lines": [
                "Kukale mu Edena yepowa kakuna mishi, mutshi wa moyo mutshi wa kujingulula wa lungenyi ni wa kuja."
              ]
            },
            {
              "type": "refrain",
              "lines": [
                "Mamu wanyi we niwa kwela mulao ni wa kwela mulao, ni wa kwela mulao.",
                "- Mulao ne ukaukeba",
                "- Mulao ne ka bwabwa keba"
              ]
            },
            {
              "type": "source_block",
              "lines": [
                "Pakalwa kilisto wakalwa pakukekula mitshi, mushi wa fwiki wakaji ne mamu ma kilisto wakakwela mulao."
              ]
            },
            {
              "type": "source_block",
              "lines": [
                "Mwanetu ne mulundatwikale ku mutshi wa moyo mutshi wa fwiki wa kaji ne mamu ma kilisto wa ka kwela mulao."
              ]
            }
          ],
          "media": {
            "audio_present": true
          }
        },
        {
          "id": "2ee179e8-9433-52fc-a843-93856aaab3ba",
          "language": {
            "code": "sw",
            "label": "Swahili",
            "status": "known"
          },
          "title": "AWALI MU EDENi",
          "source": {
            "file": "chants_deden.html",
            "position": 5,
            "number": "40",
            "reference": "awali mu edeni.mpeg"
          },
          "taxonomy": {
            "domain": "lessons",
            "category_id": "lesson-2",
            "category_label": "Éden",
            "lesson_id": "lesson-2",
            "lesson_label": "Leçon 2 — Éden"
          },
          "content": [
            {
              "type": "source_block",
              "lines": [
                "1. Awali mu Edeni Jehova kati ya miti (2x). Muti wa uzima, muti wa mauti, wa ujuzi na wa kula.(2x)"
              ]
            },
            {
              "type": "refrain",
              "lines": [
                "utapewa laaana, utapewa, utapewa laana",
                "- Na kujikuza kwako",
                "- Na bulozi bwako"
              ]
            },
            {
              "type": "source_block",
              "lines": [
                "2. alipokuja kilisto, akaja kwa kutenga miti (2x). Muti wa ujuzi kwa kukosa matunda kilisto akaupa laana (2x)."
              ]
            },
            {
              "type": "source_block",
              "lines": [
                "3.\tRafiki na mujoli tukuwe ku muti wa uzima (2x). muti wa ujuzi kwa kukosa matunda kilisto akaupa laana(2x)."
              ]
            }
          ],
          "media": {
            "audio_present": true
          }
        }
      ]
    },
