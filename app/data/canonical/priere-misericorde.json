              "type": "verse",
              "number": "1",
              "lines": [
                "Baba safisha moyo roho aingie , e takasa , takasa moyo , ginsi usafishavyo koti takasa , takasa moyo."
              ]
            },
            {
              "type": "verse",
              "number": "2",
              "lines": [
                "Mama safisha moyo roho aingie e takasa , takasa moyo ginsi usafishavyo kikwembe takasa , takasa moyo ginsi usafishavio blouse."
              ]
            },
            {
              "type": "verse",
              "number": "3",
              "lines": [
                "Kaka safisha moyo roho aingie e takasa, takasa moyo ginsi usafishavyo shiirt takasa, takasa moyo ginsi usafishavyo pantalon."
              ]
            }
