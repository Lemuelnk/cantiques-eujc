              "lines": [
                "Jehova mungu eh ee mungu , mungu mumbaji eh ee mungu \"Ukihukumu watu vikali hivi nani atakae simama duniani \"2x"
              ]
            },
            {
              "type": "verse",
              "number": "2",
              "lines": [
                "Yesu wa mungu eh ee yesu , mwana wa mungu eh ee yesu , yesu \"Kwa rehema yako yesu wangu kawokoa watu duniani \"2x"
              ]
            },
            {
              "type": "verse",
              "number": "3",
              "lines": [
                "Roho damilifu eh ee roho , roho mufariji eh ee roho kwa neema yako mwema kafariji watu duniani."
              ]
