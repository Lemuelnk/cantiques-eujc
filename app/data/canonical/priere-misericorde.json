              "type": "verse",
              "number": "1",
              "lines": [
                "Mungu wangu , mungu wangu ewe mungu wa mababu \"Ni metubu zambi zangu kwako , kwako mungu wa rehema \"2x"
              ]
            },
            {
              "type": "refrain",
              "lines": [
                "Kweli kweli ewe mungu wa rehema ameja rehema na tena na kweli nyingi."
              ]
            },
            {
              "type": "verse",
              "number": "2",
              "lines": [
                "Sasa leo ni mejuta kwa yale niliyo ya fanya na kiri sitarudi tena kuya tenda duniani."
              ]
            },
            {
              "type": "comment",
              "lines": [
                "Com : -Na ulozi wangu",
                "-Na uchawi wangu"
              ]
            }
