              "type": "verse",
              "number": "1",
              "lines": [
                "Nina tubu mimi nipate uzima bwana ni metoa vitu viangu viote uniokoe mfalme chukuwa matajiri nipate uzima wa milele."
              ]
            },
            {
              "type": "refrain",
              "lines": [
                "Bwana mungu ni metoa ee nimetoa na zaka ni pate uzima wa milele (toa basi)"
              ]
            },
            {
              "type": "comment",
              "lines": [
                "Com : -Nimetoa na ya kila siku nipate uzima wa milele -Ni metoa na ya upendo \" \" \" \" -Ni metoa na ya haadi\" \" \" \""
              ]
            },
            {
              "type": "verse",
              "number": "2",
              "lines": [
                "Naomboleza mimi nipate raha , bwana unirehumu baba ninyakuwe mbinguni , uniteuwe bwana nipate kuku Hudumia."
              ]
            },
            {
              "type": "verse",
              "number": "3",
              "lines": [
                "Nauzunika mimi nipate uzima\"2x bwana ni metoa vitu viangu viote ni vya bure via nikosesha uzima sita virudia tena."
              ]
            }
