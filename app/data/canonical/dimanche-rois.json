              ]
            },
            {
              "type": "source_block",
              "lines": [
                "Kuna wengine wana ufahamu mwingine wanawinda wana wako baba uje uwangamize, wana winda wana wako uje uwangamize, Ili wana wako mungu wangu wapate kuokolewa"
              ]
            },
            {
              "type": "source_block",
              "lines": [
