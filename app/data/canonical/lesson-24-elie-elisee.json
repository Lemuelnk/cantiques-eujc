          "content": [
            {
              "type": "source_block",
              "lines": [
                "Ukingoni mwa muto yordani Elisa na joo la Elia yuko wapi Mungu wa Elia, njoni mwone ujio wa Bwana, njoni mwone ujio."
              ]
            },
            {
              "type": "refrain",
              "lines": [
                "Muhuri wa Mungu ni vichwani mwetu atukuzwe mungu wa uzima."
              ]
            },
            {
              "type": "comment",
              "lines": [
                "- Uvuni wa moto ni vichani mwetu...",
                "atukuzwe Mungu wa uzima",
                "- Na mafuta kweli tumepakaliwa..."
              ]
            },
            {
              "type": "source_block",
              "lines": [
                "Roho mwema usemi wa Yoeli aliwaidia wa mitume na kuakikisha ju yao Roho mwema, Roho wa kristo, Roho mwema roho wa kristu."
              ]
            },
            {
              "type": "source_block",
              "lines": [
                "Akikisho la kutakasika, ushuhuda wa uduma njema, ushirika wa Mungu na watu, yu haja miongoni mwetu, yu haja miongoni."
              ]
            }
