          "content": [
            {
              "id": "blk-26537240",
              "type": "verse",
              "number": "1",
              "lines": [
                "Nitazamapo huduma uliofanya mungu kwa mikono yake chini ya jua (kweli mimi) sina na furaha mu mambo yote ya uzima wangu apa duniani."
              ]
            },
            {
              "id": "blk-1cdf75a6",
              "type": "refrain",
              "lines": [
                "Mungu akaumba mbingu na dunia mito na bahari kubwa kazi ya mikono yake mungu wangu paka wewe akuna mwingine."
              ]
            },
            {
              "id": "blk-160af4ee",
              "type": "comment",
              "lines": [
                "Com :Mumbaji wangu paka wewe akuna mwingine -Tegemeo langu paka wewe akuna mwingine"
              ]
            },
            {
              "id": "blk-f04c5f00",
              "type": "verse",
              "number": "2",
              "lines": [
                "Mungu uniokowe mu mambo ya dunia ili ni sione taabu ya mwisho wa dunia (wewe) wewe ulimutoa mwana wako wa peke ili kila mwamini asife kamwe."
              ]
            },
            {
              "id": "blk-3b78a35a",
              "type": "verse",
              "number": "3",
              "lines": [
                "Kama ukiapa kwa mungu wako usisite kamwe timiza naziri yako (kweli yeye) yeye a furahi juu ya wajinga urejee kamwe timiza haadi yako."
              ]
            }
          ]
        }
      ]
