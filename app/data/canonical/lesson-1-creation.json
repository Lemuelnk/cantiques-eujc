              "type": "verse",
              "number": "1",
              "lines": [
                "Wakati mungu yoyoyo alipo umba mbingu na dunia¨2x Akaumba nuru yoyoyo akatenga nafasi mungu akaumba miti¨2x"
              ]
            },
            {
              "id": "blk-ceb2e0fd",
              "type": "refrain",
              "lines": [
                "Kweli kweli jeho va mungu kanena nimepata kiumbe (kiumbe) kitakacho tukuza ukubwa wangu ."
              ]
            },
            {
              "id": "blk-7338f8b8",
              "type": "comment",
              "lines": [
                "Com : -Na mwalimu kanena -Mwambi wetu kanena -Baba kyungu kanena"
              ]
            },
            {
              "id": "blk-a966a614",
              "type": "verse",
              "number": "2",
              "lines": [
                "Akaumba miangaza yoyoyo akaumba nyama, mutu akuwako."
              ]
            },
            {
              "id": "blk-bfb462f0",
              "type": "verse",
              "number": "3",
              "lines": [
                "Akaumba mutu yoyoyo akamubariki muzidi na kuongezeka."
              ]
            }
          ]
        }
