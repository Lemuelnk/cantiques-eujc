          "content": [
            {
              "id": "blk-263d9a17",
              "type": "verse",
              "number": "1",
              "lines": [
                "Apo mwanzo, mungu aliziumba mbingu na inchi na bahari kubwa yoyo aa ! ¨ Roho wa mungu akatulia juu ya uso wa maji¨2x"
              ]
            },
            {
              "id": "blk-0c6b1a17",
              "type": "refrain",
              "lines": [
                "Sisi zote tuondokeni duniani tutembee juu ya bahari ili tuwe mbinguni muishimo baba , mungu wa wenye uhai inchi yani mwili, mbingu yani roho ya mungu , maji ni mafundisho, nuru ufahamu , giza ni upungufu ."
              ]
            },
            {
              "id": "blk-ccb5e6fc",
              "type": "verse",
              "number": "2",
              "lines": [
                "Mungu akatenga nuru na giza , nurumuchana , giza usiku yoyo aa ! ¨ Ati baba oh nuru ao oh giza¨2x"
              ]
            },
            {
              "id": "blk-365e87b3",
              "type": "verse",
              "number": "3",
              "lines": [
                "Inchi ikatoa majani kwa gisi yake mamboga na miti matunda na mbengu yoyo aa ! wana wa mungu toeni matunda yenye kufaha toba."
              ]
            },
            {
              "id": "blk-4a6496f4",
              "type": "verse",
              "number": "4",
              "lines": [
                "Mungu akaumba viumbe vienye uhai ayawani na ndege nyangumi majini yoyo aa ! mutu akawa mumiliki wa viote yoyo aa !"
              ]
            },
            {
              "id": "blk-b6ff15ee",
              "type": "comment",
              "lines": [
                "Com : Baba twakushukuru iyawe yoyo mungu wa wenye uhai -Uliumba dunia -Kweli sita kuacha"
              ]
            }
          ]
        }
      ]
    },
