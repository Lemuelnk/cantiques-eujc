          "content": [
            {
              "type": "source_block",
              "lines": [
                "Adama alikuwa na wana wa wili, mukubwa Kaini mulimaji udongo ( mudogo) Abeli mulinzi wa kondoo."
              ]
            },
            {
              "type": "refrain",
              "lines": [
                "Wa ndugu tu chunge neno , sisi twache ku chukiana tu sije tu kaangamia kwajili ya anas aya dunia.",
                "Alipenda kuona:....",
                "Mupendaji anasa:..."
              ]
            },
            {
              "type": "source_block",
              "lines": [
                "Siku zilipita kaini na Abeli Wote (wawili) wakatoa zabihu zao kwa bwana (udogo) Abeli kaeshimiwa."
              ]
            },
            {
              "type": "source_block",
              "lines": [
                "Sikilizeni usemi wa mumbaji enyi wajoli kama Kaini akalipishwa kisasi mara saba eh iwe kwako mara makumi sabana saba."
              ]
            },
            {
              "type": "comment",
              "lines": [
                "- Utukufu ku neno mara makumi saba na saba",
                "- Upendo kiasi\tmara makumi saba na saba"
              ]
            }
          ],
          "media": {
            "audio_present": false
          }
        }
      ]
    },
