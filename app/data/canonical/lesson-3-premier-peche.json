          },
          "content": [
            {
              "type": "source_block",
              "lines": [
                "Sauti ya Abeli kutoka shambani, ikalia shambani humo, Shambani mwa Bwana nimeuwawa bure, nimeuwawa na Kaini"
              ]
            },
            {
              "type": "refrain",
              "lines": [
                "Ndugu tutafia nini, kila mutu na zawadi yake mbele yake Mungu, Ata ukila na kunywa kwangu mimi sikitu (sikitu) kamwe sitaiga mutu."
              ]
            },
            {
              "type": "source_block",
              "lines": [
                "Nilipo kuwa humo shambani, nilipo kuwa shambani mwa Bwana, nilichukuwa gongo, sikuchukuwa upanga, ila Mungu peke yake alikuwa mwamuzi wangu.",
                "gongo langu eh baba gongo langu la uzima."
              ]
            },
            {
              "type": "source_block",
              "lines": [
                "Yule joka akisha kwaribu, utafuta afariki na nani. Upanda mbinguni, ushuka duniani, utafuta afariki na nani"
              ]
            }
          ],
          "media": {
            "audio_present": false
          }
        }
      ]
