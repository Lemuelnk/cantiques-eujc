          "content": [
            {
              "type": "source_block",
              "lines": [
                "Iki ni kilio cha Abeli mwana wa Adamu ku mashariki ya Edeni."
              ]
            },
            {
              "type": "refrain",
              "lines": [
                "Ndugu mujoli sina jambo na wewer, umeniuwa bure kumashariki ya Edeni"
              ]
            },
            {
              "type": "comment",
              "lines": [
                "- Acha asira sina jambo na wewe Umeniuwa bure ku mashariki ya Edeni",
                "- Acha chuki sina jambo na wewe",
                "- Acha fitina sina jambo na wewe"
              ]
            },
            {
              "type": "source_block",
              "lines": [
                "Mungu kauliza Kaini, ndugu yako Abeli ni wapi usinyulize mimi si muchungaji wa ndugun yangu."
              ]
            }
          ],
          "media": {
            "audio_present": false
          }
