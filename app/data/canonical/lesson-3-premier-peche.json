          "content": [
            {
              "type": "source_block",
              "lines": [
                "Enyi wanangu wa changa sikieni vinene via huduma, Abeli mutu wa kwanza yeye amemuzaa Kaini pia na Abeli."
              ]
            },
            {
              "type": "comment",
              "lines": [
                "- Chuki mu shamba: Adamu mutu wa kwanza yeye amemuzaa Kaini pia na Abeli",
                "- Wivu mu shamba:..."
              ]
            },
            {
              "type": "refrain",
              "lines": [
                "Kilio e kilio e kilio baba, kilio e Abeli kalia baba, Kaini ameniuwa, sikuwa upanga si kuchukuwa mali za shamba, ameniuwa bure ngongo",
                "langu eh baba limeogoza kondoo za mungu. Ngongo langu e kristo limeongoza kondoo za bwana."
              ]
            },
            {
              "type": "source_block",
              "lines": [
                "Siku ya sadaka yao mbele yake mumbaji wenye watu."
              ]
            },
            {
              "type": "comment",
              "lines": [
                "- Abeli mutume wa neno mumbaji wenye watu",
                "- Abeli mafundisho nzuri...",
                "- Abeli mutume wa haki...",
                "- Kaini mutume wa uongo...",
                "- Kaini mafundisho ya mwili...",
                "- Kaini mwalimu mubaya..."
              ]
            }
          ],
