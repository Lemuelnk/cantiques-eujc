              ]
            },
            {
              "type": "source_block",
              "lines": [
                "Habari njema wajoli tunayo waarifu si kwa andiko la herufi liuwalo ila yesu mwana mungu mukombozi wa watu Neno la mungu alie hai likajifanya mwili kuwaliwa mara moja na kufa mara moja kainuliwa 2x"
              ]
            },
            {
              "type": "source_block",
              "lines": [
