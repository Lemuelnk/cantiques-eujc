          "content": [
            {
              "type": "source_block",
              "lines": [
                "Mutu mumoja wa sora wa jama la dani manoa na muke wake jina lake manoa na muke wake malaika wa bwana akajirika kwao alipo kuwa shambani."
              ]
            },
            {
              "type": "refrain",
              "lines": [
                "Aleluya fahari, fahari utukufu wa jehova Mimi nazaa mwana fahari utukufu wa Neno hili. Samsoni wa Mungu fahari utukufu wa jehova",
                "Malaika kawambia mutamuzaa mwana mume mnaziri wa Mungu. Malaika wa Bwana akawagiza ivio walipo kuwa shambani.",
                "Usinyowe nyole zake, usinywe kileo cha nguvu wewe usile kitu kichafu mwana huyu mnaziri wa Mungu. Ataokowa israeli kwa wafilistini awatowe utumwani"
              ]
            }
          ],
