{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lemuelnk/cantiques-eujc/blob/main/docs/02-donnees/schema-corpus-canonique-v1.json",
  "title": "Cantiques EUJC — Canonical Hymn Corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_status",
    "taxonomy",
    "source",
    "hymns"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "corpus_status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "validated",
        "archived"
      ]
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "category_id",
        "category_label",
        "lesson_id",
        "lesson_label"
      ],
      "properties": {
        "domain": {
          "const": "lessons"
        },
        "category_id": {
          "const": "lesson-1"
        },
        "category_label": {
          "const": "Création"
        },
        "lesson_id": {
          "const": "lesson-1"
        },
        "lesson_label": {
          "const": "Leçon 1 — Création"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "extraction_file"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "extraction_file": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hymns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "schema-canonique-v1.json"
      }
    }
  }
}
