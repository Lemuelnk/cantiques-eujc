          "content": [
            {
              "id": "blk-5c6d241c",
              "type": "source_block",
              "lines": [
                "Mungu kamwambia Ezekieli, Ezekieli chukuwa ngombo ule kula ngombo ninalo kupa mwana wa watu uwe mutumishi wangu"
              ]
            },
            {
              "id": "blk-8d1ab4a8",
              "type": "refrain",
              "lines": [
                "Kweli kweli Ezekieli akanena nipe ngombo eh baba niwe mutumishi wako."
              ]
            },
            {
              "id": "blk-b12e5eec",
              "type": "comment",
              "lines": [
                "- Ngombo hii mafundisho la nipe ngombo eh baba niwe mutumishi kweli.",
                "- Mimi natarajia neno...",
                "- Ngombo hili mafundisho ya roho...",
                "- Ngombo hili neno la rohoni...",
                "- Nitafanya uduma..."
              ]
            },
            {
              "id": "blk-d4de63c5",
              "type": "source_block",
              "lines": [
                "Alipo tumia gombo ile ilikuwa utamu kinywani Bali tumboni mwake uchungu Ezekieli akavumilia"
              ]
            },
            {
              "id": "blk-2ee039e6",
              "type": "source_block",
              "lines": [
                "Ngombo ni neno la mungu baba unapo sikia ni furaha bali kwa kulitimiza ni ngumu neno hili shida kwa ziki na mambo."
              ]
            },
            {
              "id": "blk-d006f3b3",
              "type": "source_block",
              "lines": [
                "Nanyi watu walio mu yesu shikeni shauri lake musiwe wasikiaji wa neno tu wajoli nyinyi awa muwe watenda wa neno"
              ]
            },
            {
              "id": "blk-40363070",
              "type": "comment",
              "lines": [
                "- Waminifu wa neno musiwe wasikiaji wa neno tu wajoli nyinyi awa muwe watenda wa neno",
                "- Enyi wafwatao wa neno...",
                "- Kweli nyinyi awa..."
              ]
            }
          ],
          "media": {
            "audio_present": false
          }
        }
      ]
