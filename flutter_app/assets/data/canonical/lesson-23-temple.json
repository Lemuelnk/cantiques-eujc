          "content": [
            {
              "id": "blk-ccff9512",
              "type": "source_block",
              "lines": [
                "Dii dia yepowa diakala kudi Yona, ndaku muninawe (ndaye mu ninawe) bwa bubi bwa bantu bwa kutamba kumesu anyi ngani wanyi wa bambile",
                "yoyo wakujilongolola."
              ]
            },
            {
              "id": "blk-7c4d3de4",
              "type": "refrain",
              "lines": [
                "Bakela menji bantu aba bakela shobwe, shobwe ya kakwata mwambi wa nzambi ye kelekele shobwe ya",
                "ka kwata mwambi.",
                "- Shobwe inghei shobwe ikakwata mwambi wa nzambi yekelekele shobwe ya kakwata mwambi.",
                "- Shobwe ya bandi  ¨\t¨\t¨\t¨\t¨\t¨",
                "- Shobwe yoyoyo\t¨\t¨\t¨\t¨\t¨\t¨"
              ]
            },
            {
              "id": "blk-6d4a67d5",
              "type": "source_block",
              "lines": [
                "Ashisha ba kamukonka twetu kukwenzele tshinyi bwa mayi manene matalala nganyi wa bambile yoyo bwa kudji longolola."
              ]
            },
            {
              "id": "blk-88db0e20",
              "type": "source_block",
              "lines": [
                "Nungumbule nugele mu mayi tshipupu tshilwalwa yoyoyo pa bwalu bwanyi nganyi we nganyi wanyi wa bambile yoyo bwa kudji longolola."
              ]
            }
          ],
